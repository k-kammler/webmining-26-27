{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Aktuelle Datei",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "cwd": "${fileDirname}",
            "console": "internalConsole",
            "envFile": "${workspaceFolder}/.env"
        },
        {
            "name": "Aktuelle Datei mit Argumenten",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "cwd": "${fileDirname}",
            "console": "internalConsole",
            "envFile": "${workspaceFolder}/.env",
            "args": "${command:pickArgs}"
        }
    ]
}
